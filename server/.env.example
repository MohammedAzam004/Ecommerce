# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Get this from your MongoDB Atlas dashboard → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Use a strong random string (min 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_characters_here

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend URL — localhost for dev, deployed URL for production
# Example production: CLIENT_URL=https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ─── Admin Seeding ────────────────────────────────────────────────────────────
# These are used by the auto-seed in server.js to create the first admin user.
# REQUIRED: Do NOT leave defaults. Use a strong password.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourStrongAdminPassword123!
