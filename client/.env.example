# ─── Frontend Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# For local dev: leave VITE_API_URL commented out (defaults to http://localhost:5000)
# For production: set VITE_API_URL to your deployed backend URL

# Backend API URL — REQUIRED for production deployment (Vercel, Netlify, etc.)
# Example: VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=https://shopesy.onrender.com/
